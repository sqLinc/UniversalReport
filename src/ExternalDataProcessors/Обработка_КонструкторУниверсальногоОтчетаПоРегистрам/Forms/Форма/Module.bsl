#Область ПриОткрытииФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	Элементы.ПолеТипМетаданных.СписокВыбора.Добавить("Справочник");
	Элементы.ПолеТипМетаданных.СписокВыбора.Добавить("Документ");
	Элементы.ПолеТипМетаданных.СписокВыбора.Добавить("Перечисление");
	Элементы.ПолеТипМетаданных.СписокВыбора.Добавить("План видов характеристик");
	Элементы.ПолеТипМетаданных.СписокВыбора.Добавить("Регистр сведений");
	Элементы.ПолеТипМетаданных.СписокВыбора.Добавить("Регистр накопления");
	
	Элементы.ПолеВидПорядка.СписокВыбора.Добавить("ВОЗР");
	Элементы.ПолеВидПорядка.СписокВыбора.Добавить("УБЫВ");
КонецПроцедуры

	
#КонецОбласти 

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТипМетаданныхПриИзменении(Элемент)
	Элементы.ПолеОбъектМетаданных.СписокВыбора.Очистить();
	Элементы.ПолеВиртуальнаяТаблица.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(ТипМетаданных) Тогда
		Элементы.ПолеОбъектМетаданных.Доступность = Истина; 
	Иначе
		Элементы.ПолеОбъектМетаданных.Доступность = Ложь;
	КонецЕсли;
	
	ЗаполнитьПолеОбъекта();
	ОбъектМетаданных = "";	
	ПолеОбъектМетаданныхПриИзменении(Элементы.ПолеОбъектМетаданных);

КонецПроцедуры

&НаКлиенте
Процедура ПолеТипМетаданныхОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПолеТипМетаданныхОбработкаВыбора(Элемент, "", СтандартнаяОбработка);	 
КонецПроцедуры 

&НаКлиенте
Процедура ПолеОбъектМетаданныхПриИзменении(Элемент)
	ВидДанных.Очистить();
	Элементы.ПолеРеквизит.СписокВыбора.Очистить();
	Элементы.ПолеПараметрЗапроса.СписокВыбора.Очистить();
	Элементы.ПолеРесурс.СписокВыбора.Очистить();
	Элементы.ПолеИзмерение.СписокВыбора.Очистить();
	Элементы.ПолеИтоги.СписокВыбора.Очистить();
	Элементы.ПолеУпорядочитьПо.СписокВыбора.Очистить();
	Элементы.ПолеВиртуальнаяТаблица.СписокВыбора.Очистить();
	Элементы.ПолеПо.СписокВыбора.Очистить();

	Элементы.ПолеИтоги.Доступность = Ложь;
	Элементы.ПолеВиртуальнаяТаблица.Доступность = Ложь;
	Элементы.ГруппаРесурсы.Видимость = Ложь;
	Элементы.ГруппаИзмерения.Видимость = Ложь;
		
	Если ЗначениеЗаполнено(ОбъектМетаданных) Тогда 
		Если ТипМетаданных <> "Перечисление" Тогда
			Если ТипМетаданных = "Регистр сведений" ИЛИ ТипМетаданных = "Регистр накопления" Тогда
				Элементы.ПолеВиртуальнаяТаблица.Доступность = Истина; 
				ЗаполнитьПолеВиртуальнойТаблицы();
				ЗаполнитьПоляДанных("Ресурсы", "ПолеРесурс", "Ресурс", "ГруппаРесурсы");
				ЗаполнитьПоляДанных("Измерения", "ПолеИзмерение", "Измерение", "ГруппаИзмерения");
				
			КонецЕсли;
			ЗаполнитьПоляДанных("Реквизиты", "ПолеРеквизит", "Реквизит", "ПолеРеквизит");
		КонецЕсли;	
	Иначе
		Элементы.ПолеРеквизит.Доступность = Ложь;
		Элементы.ПолеПараметрЗапроса.Доступность = Ложь;  
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВиртуальнаяТаблица) Тогда
		ВиртуальнаяТаблица = "";
		ВиртуальнаяТаблицаПриИзменении(Элементы.ПолеВиртуальнаяТаблица);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитОбъектаМетаданных) Тогда
		РеквизитОбъектаМетаданных = "";
		ПолеРеквизитОбъектаПриИзменении(Элементы.ПолеРеквизит);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РесурсОбъектаМетаданных) Тогда
		РесурсОбъектаМетаданных = "";
		РесурсОбъектаМетаданныхПриИзменении(Элементы.ПолеРесурс);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИзмерениеОбъектаМетаданных) Тогда
		ИзмерениеОбъектаМетаданных = "";
		ИзмерениеОбъектаМетаданныхПриИзменении(Элементы.ПолеИзмерение);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрЗапроса) Тогда
		ПараметрЗапроса = "";
		ПолеПараметрОбъектаПриИзменении(Элементы.ПолеПараметрЗапроса);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Итоги) Тогда
		Итоги = "";
		ИтогиПриИзменении(Элементы.ПолеИтоги);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УпорядочитьПо) Тогда
		УпорядочитьПо = "";
		УпорядочитьПоПриИзменении(Элементы.ПолеУпорядочитьПо);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеОбъектМетаданныхОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПолеОбъектМетаданныхОбработкаВыбора(Элемент, "", СтандартнаяОбработка);	
КонецПроцедуры

&НаКлиенте
Процедура ВиртуальнаяТаблицаПриИзменении(Элемент)
	Для Каждого Ресурс из Элементы.ПолеРесурс.СписокВыбора Цикл
		Параметр = Элементы.ПолеПараметрЗапроса.СписокВыбора.НайтиПоЗначению(Ресурс.Значение);
		Элементы.ПолеПараметрЗапроса.СписокВыбора.Удалить(Параметр);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПараметрЗапроса) Тогда
		ПараметрЗапроса = "";
		ПолеПараметрОбъектаПриИзменении(Элементы.ПолеПараметрЗапроса); 	
	КонецЕсли;
	
	
	Для Каждого Элемент из ВидДанных Цикл
		Если Элемент.Представление = "Ресурс" Тогда
			ВидДанных.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	РегистрНачало = "";
	РегистрКонец = "";
	
	Если ЗначениеЗаполнено(ИзмерениеОбъектаМетаданных) Тогда
		ИзмерениеОбъектаМетаданных = "";
		ИзмерениеОбъектаМетаданныхПриИзменении(Элементы.ПолеИзмерение);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РесурсОбъектаМетаданных) Тогда
		РесурсОбъектаМетаданных = "";
		РесурсОбъектаМетаданныхПриИзменении(Элементы.ПолеРесурс);
	КонецЕсли;
	
	
	Элементы.ПолеРесурс.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(ОбъектМетаданных) Тогда
		РесурсыОбъекта = Реквизиты(ОбъектМетаданных, ТипМетаданных, "Ресурсы");	
		Если ЗначениеЗаполнено(ВиртуальнаяТаблица) Тогда
			Элементы.ГруппаДатаРегистра.Видимость = Истина;
			Для каждого Ресурс из РесурсыОбъекта Цикл
				ЗаполнитьРесурсыПоВиртуальнойТаблице(Ресурс);
			КонецЦикла;
		Иначе
			Для каждого Ресурс из РесурсыОбъекта Цикл
				Элементы.ПолеРесурс.СписокВыбора.Добавить(Ресурс.Значение);
				Элементы.ПолеПараметрЗапроса.СписокВыбора.Добавить(Ресурс.Значение);
				ВидДанных.Добавить(Ресурс.Значение, "Ресурс");	
				Элементы.ГруппаДатаРегистра.Видимость = Ложь;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ВиртуальнаяТаблицаОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВиртуальнаяТаблицаОбработкаВыбора(Элемент, "", СтандартнаяОбработка);
КонецПроцедуры


&НаКлиенте
Процедура ПолеРеквизитОбъектаПриИзменении(Элемент)
	
	Элементы.ПолеВидАгрегацииРеквизита.СписокВыбора.Очистить();
	ВключитьВГруппировкуРеквизит = Ложь;
	
	Если ЗначениеЗаполнено(РеквизитОбъектаМетаданных) Тогда
		Элементы.ПолеПсевдонимРеквизита.Доступность = Истина;	
		Элементы.ПолеВидАгрегацииРеквизита.Доступность = Истина;
		Элементы.КнопкаДобавитьРеквизит.Доступность = Истина;
		Элементы.КнопкаУдалитьРеквизит.Доступность = Истина;
		Элементы.ФлажокВключитьВГруппировкуРеквизит.Доступность = Истина;
		
		ТипРеквизита = Строка(ТипРеквизита(РеквизитОбъектаМетаданных, "Реквизит"));
		ЗаполнитьПолеВидАгрегации("ПолеВидАгрегацииРеквизита", ТипРеквизита);
	Иначе
		Элементы.ПолеПсевдонимРеквизита.Доступность = Ложь;
		Элементы.ПолеВидАгрегацииРеквизита.Доступность = Ложь;
		Элементы.КнопкаДобавитьРеквизит.Доступность = Ложь;
		Элементы.КнопкаУдалитьРеквизит.Доступность = Ложь;
		Элементы.ФлажокВключитьВГруппировкуРеквизит.Доступность = Ложь;
	КонецЕсли;
	ПсевдонимРеквизита = "";
	ВидАгрегацииРеквизита = "";
	
		
КонецПроцедуры

&НаКлиенте
Процедура РесурсОбъектаМетаданныхПриИзменении(Элемент)
	Элементы.ПолеВидАгрегацииРесурса.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(РесурсОбъектаМетаданных) Тогда
		Элементы.ПолеПсевдонимРесурса.Доступность = Истина;	
		Элементы.ПолеВидАгрегацииРесурса.Доступность = Истина;
		Элементы.КнопкаДобавитьРесурс.Доступность = Истина;
		Элементы.КнопкаУдалитьРесурс.Доступность = Истина;
		Если ЗначениеЗаполнено(ВиртуальнаяТаблица) Тогда
			Ресурс = РесурсБезСуффикса(РесурсОбъектаМетаданных, ВиртуальнаяТаблица);
			ТипРеквизита = Строка(ТипРеквизита(Ресурс, "Ресурс"));
		Иначе
			ТипРеквизита = Строка(ТипРеквизита(РесурсОбъектаМетаданных, "Ресурс"));
		КонецЕсли;
		ЗаполнитьПолеВидАгрегации("ПолеВидАгрегацииРесурса", ТипРеквизита);
		
	Иначе
		Элементы.ПолеПсевдонимРесурса.Доступность = Ложь;
		Элементы.ПолеВидАгрегацииРесурса.Доступность = Ложь;
		Элементы.КнопкаДобавитьРесурс.Доступность = Ложь;
		Элементы.КнопкаУдалитьРесурс.Доступность = Ложь;
	КонецЕсли;
	ПсевдонимРесурса = "";
	ПолеВидАгрегацииРесурса = "";

КонецПроцедуры

&НаКлиенте
Процедура ИзмерениеОбъектаМетаданныхПриИзменении(Элемент)
	Элементы.ПолеВидАгрегацииИзмерения.СписокВыбора.Очистить();
	ВключитьВГруппировкуИзмерение = Ложь;
	
	Если ЗначениеЗаполнено(ИзмерениеОбъектаМетаданных) Тогда
		Элементы.ПолеПсевдонимИзмерения.Доступность = Истина;	
		Элементы.ПолеВидАгрегацииИзмерения.Доступность = Истина;
		Элементы.КнопкаДобавитьИзмерение.Доступность = Истина;
		Элементы.КнопкаУдалитьИзмерение.Доступность = Истина;
		Элементы.ФлажокВключитьВГруппировкуИзмерение.Доступность = Истина;
		
		ТипРеквизита = Строка(ТипРеквизита(ИзмерениеОбъектаМетаданных, "Измерение"));
		ЗаполнитьПолеВидАгрегации("ПолеВидАгрегацииИзмерения", ТипРеквизита);
	Иначе
		Элементы.ПолеПсевдонимИзмерения.Доступность = Ложь;
		Элементы.ПолеВидАгрегацииИзмерения.Доступность = Ложь;
		Элементы.КнопкаДобавитьИзмерение.Доступность = Ложь;
		Элементы.КнопкаУдалитьИзмерение.Доступность = Ложь;
		Элементы.ФлажокВключитьВГруппировкуРеквизит.Доступность = Ложь;
	КонецЕсли;
	ПсевдонимИзмерения = "";
	ПолеВидАгрегацииИзмерения = "";
КонецПроцедуры

&НаКлиенте
Процедура ПолеПараметрОбъектаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ПараметрЗапроса) Тогда
		Элементы.КнопкаУдалитьПараметр.Доступность = Истина;
		Если ДобавитьМежду Тогда
			УдалитьПоляДляМежду();
			ДобавитьМежду = Ложь;
			ДобавитьМеждуПриИзменении(Элементы.ФлажокДобавитьМежду);
		Иначе
			УдалитьПолеИРеквизитЗначениеПараметра();
			ДобавитьПолеИРеквизитЗначениеПараметра();
		КонецЕсли;
	Иначе
		УдалитьПоляДляМежду();
		УдалитьПолеИРеквизитЗначениеПараметра();
		Элементы.ФлажокДобавитьМежду.Доступность = Ложь;
		ДобавитьМежду = Ложь;
		Элементы.КнопкаУдалитьПараметр.Доступность = Ложь;
		
	КонецЕсли;
	Элементы.КнопкаДобавитьПараметр.Доступность = Ложь;
		
КонецПроцедуры

&НаКлиенте
Процедура ПолеЗначениеПараметраПриИзменении(Элемент)
	Если ОтключитьКнопку Тогда
		Элементы.КнопкаДобавитьПараметр.Доступность = Ложь;
	Иначе
		ВсеРеквизитыЗаполнены = Истина;
		ЭлементыГруппы = Элементы.Найти("ГруппаВводЗначенияПараметра").ПодчиненныеЭлементы;
		Если ЭлементыГруппы.Количество() > 0 Тогда
			Для каждого ЭлементГруппы из ЭлементыГруппы цикл
				Если НЕ ЗначениеЗаполнено(ЭлементГруппы.ТекстРедактирования) Тогда
					ВсеРеквизитыЗаполнены =  Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если ВсеРеквизитыЗаполнены Тогда
			Элементы.КнопкаДобавитьПараметр.Доступность = Истина;
		Иначе
			Элементы.КнопкаДобавитьПараметр.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	ОтключитьКнопку = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПолеЗначениеПараметраОчистка(Элемент);
	ОтключитьКнопку = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьМеждуПриИзменении(Элемент)
		
	Элементы.КнопкаДобавитьПараметр.Доступность = Ложь;
	Если ДобавитьМежду Тогда
		УдалитьПолеИРеквизитЗначениеПараметра();
		ДобавитьПоляДляМежду(ПримитивныйТипПараметра);
	Иначе
		УдалитьПоляДляМежду();
		ДобавитьПолеИРеквизитЗначениеПараметра();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидПорядкаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(ВидПорядка) Тогда
		Элементы.КнопкаДобавитьПорядок.Доступность = Истина;
	Иначе
		Элементы.КнопкаДобавитьПорядок.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолеМеждуПриИзменении(Элемент)
	ПервыйРеквизит = ЗначениеРеквизитаПоНазванию("ПервыйМежду");
	ВторойРеквизит = ЗначениеРеквизитаПоНазванию("ВторойМежду");

	Если ЗначениеЗаполнено(ПервыйРеквизит) И ЗначениеЗаполнено(ВторойРеквизит) Тогда
		Элементы.КнопкаДобавитьПараметр.Доступность = Истина;
	Иначе
		Элементы.КнопкаДобавитьПараметр.Доступность = Ложь;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УпорядочитьПоПриИзменении(Элемент)
	Если ЗначениеЗаполнено(УпорядочитьПо) Тогда
		Элементы.ПолеВидПорядка.Доступность = Истина;
		Элементы.КнопкаУдалитьПорядок.Доступность = Истина;
	Иначе
		Элементы.ПолеВидПорядка.Доступность = Ложь;
		Элементы.КнопкаУдалитьПорядок.Доступность = Ложь;
		ВидПорядка = "";

	КонецЕсли;
	ВидПорядкаПриИзменении(Элементы.ПолеВидПорядка);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогиПриИзменении(Элемент)

	УдалитьДекорациюИтоги();
	
	Если ЗначениеЗаполнено(Итоги) Тогда
		ДобавитьДекорациюИтоги();
		Элементы.ПолеПо.Доступность = Истина;
	Иначе
		Элементы.ПолеПо.Доступность = Ложь;
	КонецЕсли;
	ИтогиПо = "";
	ПоПриИзменении(Элементы.ПолеПо);	
КонецПроцедуры

&НаКлиенте
Процедура ПоПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ИтогиПо) Тогда
		Элементы.КнопкаДобавитьИтогиПо.Доступность = Истина;
		Элементы.КнопкаУдалитьИтогиПо.Доступность = Истина;
	Иначе
		Элементы.КнопкаДобавитьИтогиПо.Доступность = Ложь;
		Элементы.КнопкаУдалитьИтогиПо.Доступность = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолеАгрегацияПриИзменении(Элемент)

	Если ЗначениеЗаполнено(ВидАгрегацииРеквизита) Тогда
		Элементы.ФлажокВключитьВГруппировкуРеквизит.Доступность = Ложь;
		ВключитьВГруппировкуРеквизит = Ложь;
	Иначе
		Элементы.ФлажокВключитьВГруппировкуРеквизит.Доступность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолеВидАгрегацииИзмеренияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ПолеВидАгрегацииИзмерения) Тогда
		Элементы.ФлажокВключитьВГруппировкуИзмерение.Доступность = Ложь;
		ВключитьВГруппировкуИзмерение = Ложь;
	Иначе
		Элементы.ФлажокВключитьВГруппировкуИзмерение.Доступность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИспГруппировкуПриИзменении(Элемент)
	Если ВключитьВГруппировкуРеквизит Тогда
		Элементы.ПолеВидАгрегацииРеквизита.Доступность = Ложь;
		ВидАгрегацииРеквизита = "";
	Иначе
		Элементы.ПолеВидАгрегацииРеквизита.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ВключитьВГруппировкуИзмерениеПриИзменении(Элемент)
	Если ВключитьВГруппировкуИзмерение Тогда
		Элементы.ПолеВидАгрегацииИзмерения.Доступность = Ложь;
		ПолеВидАгрегацииИзмерения = "";
	Иначе
		Элементы.ПолеВидАгрегацииИзмерения.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти 

#Область УдалениеДанных

&НаСервере
Процедура УдалитьДекорациюИтоги()
	
	ЭлементыГруппы = Элементы.ГруппаИтоги.ПодчиненныеЭлементы;	
	Если ЭлементыГруппы <> Неопределено Тогда
		Для каждого Элемент из ЭлементыГруппы Цикл
			Если Элемент.Заголовок <> Итоги Тогда
				Элементы.Удалить(Элемент);
				УдалитьВсеДекорацииПо();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УдалитьДекорациюПо()
	
	
	Элемент = Элементы.Найти("По"+ИтогиПо);
	Если Элемент <> Неопределено Тогда
		Элементы.Удалить(Элемент);
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПоляДляМежду()
	
	ЭлементыГруппы = Элементы.ГруппаПоляМежду.ПодчиненныеЭлементы;
	РеквизитыЭлементовГруппы = Новый Массив;
	
	Если ЭлементыГруппы.Количество() > 0 Тогда
		Индекс = ЭлементыГруппы.Количество() - 1; 
		Пока Индекс >= 0 Цикл
			Если ЭлементыГруппы[Индекс].Заголовок <> "И" Тогда 
				РеквизитыЭлементовГруппы.Добавить(ЭлементыГруппы[Индекс].ПутьКДанным);
			КонецЕсли;
			Элементы.Удалить(ЭлементыГруппы[Индекс]);
			Индекс = Индекс - 1;
			
		КонецЦикла;
	    	ИзменитьРеквизиты(, РеквизитыЭлементовГруппы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьДекорациюУпорядочитьПо(Имя)
	
	
	Элемент = Элементы.Найти(Имя);
	Если Элемент <> Неопределено Тогда
		Элементы.Удалить(Элемент);
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура УдалитьВсеДекорацииПо()
	Группа = Элементы.ГруппаПо.ПодчиненныеЭлементы;
	КоличествоЭлементов = Элементы.ГруппаПо.ПодчиненныеЭлементы.Количество();
	Индекс = КоличествоЭлементов - 1;
	
	Пока Индекс >= 0 Цикл
		Элементы.Удалить(Группа[Индекс]);
		Индекс = Индекс - 1;
	КонецЦикла 
	
КонецПроцедуры


&НаСервере
Процедура УдалитьПолеИРеквизитЗначениеПараметра()
	ЭлементыГруппы = Элементы.Найти("ГруппаВводЗначенияПараметра").ПодчиненныеЭлементы;
	РеквизитыЭлементовГруппы = Новый Массив;
		
	
	
	Если ЭлементыГруппы.Количество() > 0 Тогда
		Для каждого ЭлементГруппы из ЭлементыГруппы Цикл
			РеквизитыЭлементовГруппы.Добавить(ЭлементГруппы.ПутьКДанным);
			Элементы.Удалить(ЭлементГруппы);
			
		КонецЦикла;
	
		ИзменитьРеквизиты(, РеквизитыЭлементовГруппы);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УдалитьИзИтогов(Итоги, ИмяДекорации)
	
	Элемент = Элементы.ПолеИтоги.СписокВыбора.НайтиПоЗначению(Итоги);
	Элементы.ПолеИтоги.СписокВыбора.Удалить(Элемент);
	Итоги = "";
	УдалитьДекорациюИтоги();
	
		
	
КонецПроцедуры

&НаСервере
Процедура УдалитьИзПо(РеквизитОбъектаМетаданных)
	Попытка
		Элемент = Элементы.ПолеПо.СписокВыбора.НайтиПоЗначению(РеквизитОбъектаМетаданных);
		ДекорацииПо = Элементы.ГруппаПо.ПодчиненныеЭлементы;
		Для каждого Декорация из ДекорацииПо Цикл
			Если Декорация.Заголовок = Элемент Тогда
				УдалитьДекорациюПо(); 
			КонецЕсли;
		КонецЦикла;
		ЭлементПоЗначению = Элементы.ПолеПо.СписокВыбора.НайтиПоЗначению(РеквизитОбъектаМетаданных);
		Элементы.ПолеПо.СписокВыбора.Удалить(ЭлементПоЗначению);
		Если Элементы.ПолеПо.СписокВыбора.Количество() = 0 Тогда
			Элементы.ПолеПо.Доступность = Ложь;
			ИтогиПо = "";
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура УдалитьРеквизит(Имя) 	
	Элемент = Элементы.Найти(Имя);
	
	ЭлементИтог = Элементы.Найти("Итоги"+Имя);
	Если ЭлементИтог <> Неопределено Тогда
		УдалитьИзИтогов(Итоги, ЭлементИтог.Имя);
		УдалитьВсеДекорацииПо();
	КонецЕсли;
	
	
	УдалитьИзУпорядочитьПо(Элемент.Имя);
	УдалитьДекорациюУпорядочитьПо("Упорядочить"+Элемент.Имя);
	
		
	ГрЭлемент = Элементы.Найти("Гр"+Имя);
	
	УдалитьИзПо(Элемент.Заголовок);
	

	Элементы.Удалить(Элемент);
	Если ГрЭлемент <> Неопределено Тогда
		Элементы.Удалить(ГрЭлемент);	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьИзУпорядочитьПо(Имя)
	Значение = Элементы.ПолеУпорядочитьПо.СписокВыбора.НайтиПоЗначению(Имя);
	Если Значение <> Неопределено Тогда
		Элементы.ПолеУпорядочитьПо.СписокВыбора.Удалить(Значение);
	КонецЕсли;
	
	Если Имя = УпорядочитьПо Тогда
		УпорядочитьПо = "";
		ВидПорядка = "";
		Элементы.ПолеВидПорядка.Доступность = Ложь;
		Элементы.КнопкаДобавитьПорядок.Доступность = Ложь;
		Элементы.КнопкаУдалитьПорядок.Доступность = Ложь;
	КонецЕсли;
	
	
	Если Элементы.ПолеУпорядочитьПо.СписокВыбора.Количество() = 0 Тогда
		Элементы.ПолеУпорядочитьПо.Доступность = Ложь;
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПараметр(Имя)
	Если СтрНайти(Имя, "Надпись") <> 0 Тогда
		Надпись = Элементы.Найти(Имя);
		Элементы.Удалить(Надпись);
		Для каждого Параметр из ЗначенияПараметров цикл                                   
			Если Параметр.Представление = ПараметрЗапроса Тогда
				ЗначенияПараметров.Удалить(Параметр);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Надпись = Элементы.Найти(Имя);
		Элементы.Удалить(Надпись);
		Для каждого Параметр из ЗначенияПараметров Цикл
			Если Строка(Тип(Параметр.Значение)) = "Массив" Тогда
				ЗначенияПараметров.Удалить(Параметр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти 

