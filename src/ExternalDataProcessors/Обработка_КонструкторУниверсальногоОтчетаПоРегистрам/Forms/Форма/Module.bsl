&НаКлиенте
Процедура КомСформироватьОтчет(Команда)
	Если ТипМетаданных = "Перечисление" Тогда
		СформироватьОтчет();
	Иначе
		
		Если Элементы.ГруппаВыбрать.ПодчиненныеЭлементы.Количество() = 0 Тогда
			ПоказатьПредупреждение(, "Вы не выбрали реквизиты для показа в отчете");
		Иначе
			Если ЗначениеЗаполнено(ВиртуальнаяТаблица) Тогда
				Если НЕ ЗначениеЗаполнено(РегистрКонец) ИЛИ НЕ ЗначениеЗаполнено(РегистрНачало) Тогда
					ПоказатьПредупреждение(, "Необходимый параметр даты не указан для регистра");
				Иначе
					Если РегистрНачало > РегистрКонец Тогда
						ПоказатьПредупреждение(, "Дата начала не может быть больше даты конца");
					Иначе
						СформироватьОтчет();
					КонецЕсли;
	
				КонецЕсли;
			Иначе
				СформироватьОтчет();
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомДобавитьПараметр(Команда)
	Если Элементы.Найти("Надпись"+ПараметрЗапроса) <> Неопределено Тогда
			ПоказатьПредупреждение(, "Данный параметр уже добавлен!", 10, "Добавление параметра");
		Иначе
			Если ДобавитьМежду Тогда
				ДобавитьПараметр(Истина);
			Иначе
				ДобавитьПараметр(Ложь);
			КонецЕсли;
		КонецЕсли;

КонецПроцедуры 

#КонецОбласти 

#Область ДобавлениеЭлементовВФорму

&НаСервере
Процедура ДобавитьПолеИРеквизитЗначениеПараметра()
	Если ЗначениеЗаполнено(ПараметрЗапроса) Тогда
		Вид = ВидДанных.НайтиПоЗначению(ПараметрЗапроса);
		Если Вид <> Неопределено Тогда
			Представление = Вид.Представление;
		Иначе
			Представление = "";
		КонецЕсли;
		Параметр = РесурсБезСуффикса(ПараметрЗапроса, ВиртуальнаяТаблица);
		ТипПараметра = ТипРеквизита(Параметр, Представление);
		Если Строка(ТипПараметра) = "Строка" ИЛИ Строка(ТипПараметра) = "Число" ИЛИ Строка(ТипПараметра) = "Дата" Тогда
			Элементы.ФлажокДобавитьМежду.Доступность = Истина;
			ПримитивныйТипПараметра = Строка(ТипПараметра);
		Иначе
			Элементы.ФлажокДобавитьМежду.Доступность = Ложь;
		КонецЕсли;
		
		Реквизиты = Новый Массив;
	    ОписаниеТипа = Новый ОписаниеТипов(ТипПараметра);
	    НовыйРеквизит = Новый РеквизитФормы("Параметр"+ПараметрЗапроса, ОписаниеТипа);
	    Реквизиты.Добавить(НовыйРеквизит);
	    ИзменитьРеквизиты(Реквизиты);
	    
	    
	    Группа = Элементы.ГруппаВводЗначенияПараметра;
	    Поле = Элементы.Добавить("Поле"+ПараметрЗапроса, Тип("ПолеФормы"), Группа);
				
		Если  ТипПараметра = "Булево" Тогда
			Поле.Вид = ВидПоляФормы.ПолеФлажка;
		Иначе
			Поле.Вид = ВидПоляФормы.ПолеВвода;
			Поле.КнопкаОчистки = Истина;
		КонецЕсли;
		
	    Поле.ПутьКДанным = "Параметр"+ПараметрЗапроса; 
		Поле.Заголовок = ПараметрЗапроса; 
	    Поле.Ширина = 200;
		
		Поле.УстановитьДействие("ПриИзменении", "ПолеЗначениеПараметраПриИзменении");
		Поле.УстановитьДействие("Очистка", "ПолеЗначениеПараметраОчистка");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоляДляМежду(ПримитивныйТипПараметра)
	
		Реквизиты = Новый Массив;
	    ОписаниеТипа = Новый ОписаниеТипов(ПримитивныйТипПараметра);
	    ПервыйРеквизит = Новый РеквизитФормы("ПервыйМежду", ОписаниеТипа);
		ВторойРеквизит = Новый РеквизитФормы("ВторойМежду", ОписаниеТипа);
	    Реквизиты.Добавить(ПервыйРеквизит);
		Реквизиты.Добавить(ВторойРеквизит);

	    ИзменитьРеквизиты(Реквизиты);
	    Группа = Элементы.ГруппаПоляМежду;
	    ПолеПервое = Элементы.Добавить("ПолеПервоеМежду", Тип("ПолеФормы"), Группа);
		Декорация = Элементы.Добавить("ДекорацияМежду", Тип("ДекорацияФормы"), Группа);
		Декорация.Заголовок = "И";
		ПолеВторое = Элементы.Добавить("ПолеВтороеМежду", Тип("ПолеФормы"), Группа);
		
		
		ПолеПервое.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВторое.Вид = ВидПоляФормы.ПолеВвода;
		
	    ПолеПервое.ПутьКДанным = "ПервыйМежду";
		ПолеВторое.ПутьКДанным = "ВторойМежду";
		ПолеПервое.Заголовок = "Параметр 1";
		ПолеВторое.Заголовок = "Параметр 2";
	    ПолеПервое.Ширина = 100;
		ПолеВторое.Ширина = 100;
		
		ПолеПервое.КнопкаОчистки = Истина;
		ПолеВторое.КнопкаОчистки = Истина;
		
		ПолеПервое.УстановитьДействие("ПриИзменении", "ПолеМеждуПриИзменении");
		ПолеВторое.УстановитьДействие("ПриИзменении", "ПолеМеждуПриИзменении");
	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДекорациюИтоги()
	
	Группа = Элементы.ГруппаИтоги;
	
	Имя = СтрокаБезСкобок(Итоги);
	
	ИмяДекорации = "Итоги" + Имя;
	
	Надпись = Элементы.Добавить(ИмяДекорации, Тип("ДекорацияФормы"), Группа);
	Надпись.Заголовок = Итоги;
	Надпись.Ширина = 200; 
	Если ЗначениеЗаполнено(ВиртуальнаяТаблица) Тогда
			Надпись.Подсказка = ВиртуальнаяТаблица;
	КонецЕсли;

	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДекорациюПо(Тип)
	
	Группа = Элементы.ГруппаПо;
	Имя = "По" + ИтогиПо;
	
	Надпись = Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Группа);
	Надпись.Заголовок = ИтогиПо;
	Надпись.Ширина = 200;
	Если Тип <> "Реквизит" Тогда
		Если ЗначениеЗаполнено(ВиртуальнаяТаблица) Тогда
			Надпись.Подсказка = ВиртуальнаяТаблица;
		КонецЕсли;
	КонецЕсли;

	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДекорациюУпорядочить(Тип)
	Группа = Элементы.ГруппаУпорядочитьПо;
	Имя = "Упорядочить" + УпорядочитьПо;
	
	Надпись = Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Группа);
	Надпись.Заголовок = УпорядочитьПо + " " + ВидПорядка;
	Надпись.Ширина = 200;
	Если Тип <> "Реквизит" Тогда
		Если ЗначениеЗаполнено(ВиртуальнаяТаблица) Тогда
			Надпись.Подсказка = ВиртуальнаяТаблица;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизит(ЕстьПсевдоним, Имя, ВидАгрегацииРеквизита, ВключитьВГруппировку, Псевдоним = "", ЭтоРеквизит = Истина);
	
	Группа = Элементы.ГруппаВыбрать;
	Надпись = Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Группа);
	Если НЕ ЭтоРеквизит Тогда
		Если ЗначениеЗаполнено(ВиртуальнаяТаблица) Тогда
			Надпись.Подсказка = ВиртуальнаяТаблица;
		КонецЕсли;
	КонецЕсли;
	Если ЕстьПсевдоним Тогда
		ДобавитьВУпорядочить(Имя);
		Если НЕ ЗначениеЗаполнено(ВидАгрегацииРеквизита) Тогда
			
			Надпись.Заголовок = Имя + " КАК " + Псевдоним;
							
			
			ДобавитьВПо(Имя);
			
			Если ВключитьВГруппировку Тогда
				ГрГруппировка = Элементы.ГруппаСгруппироватьПо;
				НадписьВГруппировку = Элементы.Добавить("Гр"+Имя, Тип("ДекорацияФормы"), ГрГруппировка);
				НадписьВГруппировку.Заголовок = Имя;
				НадписьВГруппировку.Ширина = 200;
				Если ЗначениеЗаполнено(ВиртуальнаяТаблица) И НЕ ЭтоРеквизит Тогда
					НадписьВГруппировку.Подсказка = ВиртуальнаяТаблица;
				КонецЕсли;


			КонецЕсли;

				
				
		Иначе
			Надпись.Заголовок = ВидАгрегацииРеквизита + "(" + Имя + ")" + " КАК " + Псевдоним;
			
			
			ДобавитьВИтоги(ВидАгрегацииРеквизита + "(" + Псевдоним + ")");
			
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(ВидАгрегацииРеквизита) Тогда
			Надпись.Заголовок = Имя;
			ДобавитьВПо(Имя);
			ДобавитьВУпорядочить(Имя);
			Если ВключитьВГруппировку Тогда
				ГрГруппировка = Элементы.ГруппаСгруппироватьПо;
				НадписьВГруппировку = Элементы.Добавить("Гр"+Имя, Тип("ДекорацияФормы"), ГрГруппировка);
				НадписьВГруппировку.Заголовок = Имя;
				НадписьВГруппировку.Ширина = 200;
				Если ЗначениеЗаполнено(ВиртуальнаяТаблица) И НЕ ЭтоРеквизит Тогда
					НадписьВГруппировку.Подсказка = ВиртуальнаяТаблица;
				КонецЕсли;

			КонецЕсли;	
		КонецЕсли;
		
	КонецЕсли;
	Надпись.Ширина = 200;
	
	
  
КонецПроцедуры

&НаСервере
Процедура ДобавитьВУпорядочить(Реквизит)
	СуществующийЭлемент = Элементы.ПолеУпорядочитьПо.СписокВыбора.НайтиПоЗначению(Реквизит);
	Если СуществующийЭлемент = Неопределено Тогда
		Элементы.ПолеУпорядочитьПо.СписокВыбора.Добавить(Реквизит);
		Элементы.ПолеУпорядочитьПо.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВПо(Реквизит)
	СуществующийЭлемент = Элементы.ПолеПо.СписокВыбора.НайтиПоЗначению(Реквизит);
	Если СуществующийЭлемент = Неопределено Тогда
		Элементы.ПолеПо.СписокВыбора.Добавить(Реквизит);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьВИтоги(АгрегированныйРеквизит)
	СуществующийЭлемент = Элементы.ПолеИтоги.СписокВыбора.НайтиПоЗначению(АгрегированныйРеквизит);
	Если СуществующийЭлемент = Неопределено Тогда
		Элементы.ПолеИтоги.СписокВыбора.Добавить(АгрегированныйРеквизит);
		Элементы.ПолеИтоги.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ДобавитьПараметр(ЕстьМежду)
	Если НЕ ЕстьМежду Тогда
		Группа = Элементы.ГруппаГде;
		Надпись = Элементы.Добавить("Надпись"+ПараметрЗапроса, Тип("ДекорацияФормы"), Группа);
		Надпись.Заголовок = ПараметрЗапроса + " = " + ЭтотОбъект["Параметр"+ПараметрЗапроса];
		ЗначенияПараметров.Добавить(ЭтотОбъект["Параметр"+ПараметрЗапроса], ПараметрЗапроса);
		Надпись.Ширина = 200;
	Иначе
		Группа = Элементы.ГруппаГде;
		Надпись = Элементы.Добавить("НадписьСМежду"+ПараметрЗапроса, Тип("ДекорацияФормы"), Группа);
		Надпись.Заголовок = ПараметрЗапроса + " МЕЖДУ " + ЭтотОбъект["ПервыйМежду"] + " И " + ЭтотОбъект["ВторойМежду"];
		МассивДвухПараметров = Новый Массив;
		МассивДвухПараметров.Добавить(ЭтотОбъект["ПервыйМежду"]);
		МассивДвухПараметров.Добавить(ЭтотОбъект["ВторойМежду"]);
		ЗначенияПараметров.Добавить(МассивДвухПараметров, ПараметрЗапроса);
		Надпись.Ширина = 200;
	КонецЕсли
КонецПроцедуры


	
#КонецОбласти 

#Область ОбработчикиДиалоговогоОкна

&НаКлиенте
Процедура ПолеОбъектМетаданныхОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	КоличествоВыбрать = Элементы.ГруппаВыбрать.ПодчиненныеЭлементы.Количество();
	КоличествоГде = Элементы.ГруппаГде.ПодчиненныеЭлементы.Количество();
	
	Если ОбъектМетаданных <> ВыбранноеЗначение Тогда
		Если КоличествоВыбрать > 0 ИЛИ КоличествоГде > 0 Тогда
			Вопрос = "Вы действительно хотите изменить объект метаданных? Список реквизитов и параметров очистится!";
			ЗадатьВопрос(Вопрос, ВыбранноеЗначение, "Объект");
		Иначе
			ОбъектМетаданных = ВыбранноеЗначение;
			ПолеОбъектМетаданныхПриИзменении(Элемент);
		КонецЕсли;
	Иначе
		ОбъектМетаданных = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПолеТипМетаданныхОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	КоличествоВыбрать = Элементы.ГруппаВыбрать.ПодчиненныеЭлементы.Количество();
	КоличествоГде = Элементы.ГруппаГде.ПодчиненныеЭлементы.Количество();
	
	Если ТипМетаданных <> ВыбранноеЗначение Тогда
		Если КоличествоВыбрать > 0 ИЛИ КоличествоГде > 0 Тогда
			Вопрос = "Вы действительно хотите изменить тип метаданных? Список реквизитов и параметров очистится!";
			ЗадатьВопрос(Вопрос, ВыбранноеЗначение, "Тип");
		Иначе
			ТипМетаданных = ВыбранноеЗначение;
			ТипМетаданныхПриИзменении(Элемент);
		КонецЕсли;
	Иначе
		ТипМетаданных = ВыбранноеЗначение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВиртуальнаяТаблицаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	КоличествоРеквизитов = Элементы.ГруппаВыбрать.ПодчиненныеЭлементы.Количество();
	КоличествоПараметров = Элементы.ГруппаГде.ПодчиненныеЭлементы.Количество();
	
	Если ВиртуальнаяТаблица <> ВыбранноеЗначение Тогда
		Если КоличествоРеквизитов <> 0 ИЛИ КоличествоПараметров <> 0 Тогда
			Вопрос = "Вы действительно хотите изменить виртуальную таблицу метаданных? Выбранные реквизиты очистятся!";
			ЗадатьВопрос(Вопрос, ВыбранноеЗначение, "Виртуальная");
		Иначе
			ВиртуальнаяТаблица = ВыбранноеЗначение;
			ВиртуальнаяТаблицаПриИзменении(Элемент);
		КонецЕсли;
	Иначе
		ВиртуальнаяТаблица = ВыбранноеЗначение;
	КонецЕсли;;
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопрос(Вопрос, ВыбранноеЗначение, Вид)
	Настройки = Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение);
	Настройки.Вставить("Вид", Вид);
	Оповещение = Новый ОписаниеОповещения("ОбработкаОтветаНаВопрос", ЭтотОбъект, Настройки);
	ПоказатьВопрос(Оповещение, Вопрос, РежимДиалогаВопрос.ДаНет, , , "Редактирование объекта метаданных");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопрос(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		КоличествоРеквизитов = Элементы.ГруппаВыбрать.ПодчиненныеЭлементы.Количество();
		КоличествоПараметров = Элементы.ГруппаГде.ПодчиненныеЭлементы.Количество();
		
		
		Пока КоличествоРеквизитов - 1 >= 0  Цикл
			КоличествоРеквизитов = КоличествоРеквизитов - 1;
			Элемент = Элементы.ГруппаВыбрать.ПодчиненныеЭлементы.Получить(КоличествоРеквизитов).Имя;
			УдалитьРеквизит(Элемент);
		КонецЦикла;
		
		Пока КоличествоПараметров - 1 >= 0  Цикл
			КоличествоПараметров = КоличествоПараметров - 1;
			Элемент = Элементы.ГруппаГде.ПодчиненныеЭлементы.Получить(КоличествоПараметров).Имя;
			УдалитьПараметр(Элемент);
		КонецЦикла;
		
		Если ДополнительныеПараметры.Вид = "Тип" Тогда
			ТипМетаданных = ДополнительныеПараметры.ВыбранноеЗначение;
			ТипМетаданныхПриИзменении(Элементы.ПолеТипМетаданных);
		ИначеЕсли ДополнительныеПараметры.Вид = "Виртуальная" Тогда
			ВиртуальнаяТаблица = ДополнительныеПараметры.ВыбранноеЗначение;
			ВиртуальнаяТаблицаПриИзменении(Элементы.ПолеВиртуальнаяТаблица);
		Иначе
			ОбъектМетаданных = ДополнительныеПараметры.ВыбранноеЗначение;
			ПолеОбъектМетаданныхПриИзменении(Элементы.ПолеОбъектМетаданных);

		КонецЕсли;
				
	КонецЕсли;
КонецПроцедуры


#КонецОбласти 

#Область РаботаСДанными

&НаКлиенте
Процедура ЗаполнитьПоляДанных(ТипДанных, НазваниеПоля, ВидРеквизита, НазваниеЭлементаВидимости) 
	Данные = Реквизиты(ОбъектМетаданных, ТипМетаданных, ТипДанных);
	КоличествоДанных = Данные.Количество();
	ЭлементВидимости = Элементы.Найти(НазваниеЭлементаВидимости);
	ЭтоГруппа = СтрНайти(НазваниеЭлементаВидимости, "Группа");
	Если КоличествоДанных = 0 Тогда
		Если ЭтоГруппа <> 0 Тогда
			ЭлементВидимости.Видимость = Ложь;
		Иначе
			ЭлементВидимости.Доступность = Ложь;
		КонецЕсли;
	Иначе
		Если ЭтоГруппа <> 0 Тогда
			ЭлементВидимости.Видимость = Истина;
		Иначе
			ЭлементВидимости.Доступность = Истина;
		КонецЕсли;
		Элементы.ПолеПараметрЗапроса.Доступность = Истина;

		Для каждого Реквизит из Данные Цикл
			ЭлементФормы = Элементы.Найти(НазваниеПоля);
			ЭлементФормы.СписокВыбора.Добавить(Реквизит.Значение);
			Элементы.ПолеПараметрЗапроса.СписокВыбора.Добавить(Реквизит.Значение);
			ВидДанных.Добавить(Реквизит.Значение, ВидРеквизита);	
		КонецЦикла
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПолеВиртуальнойТаблицы()
	ВиртуальныеТаблицы = ВиртуальныеТаблицы(ТипМетаданных);
	Для каждого Таблица Из ВиртуальныеТаблицы Цикл		
		Элементы.ПолеВиртуальнаяТаблица.СписокВыбора.Добавить(Таблица);			
	КонецЦикла;
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьПолеОбъекта()
	ОбъектыМетаданных = ОбъектМетаданных(ТипМетаданных);
	Для каждого ОбъектМетаданных из ОбъектыМетаданных Цикл
		Элементы.ПолеОбъектМетаданных.СписокВыбора.Добавить(Строка(ОбъектМетаданных));
	КонецЦикла;
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьРесурсыПоВиртуальнойТаблице(Ресурс) 
	Если ВиртуальнаяТаблица = "Остаток" ИЛИ ВиртуальнаяТаблица = "Оборот" Тогда
		Значение = Ресурс.Значение + ВиртуальнаяТаблица;
		Элементы.ПолеРесурс.СписокВыбора.Добавить(Значение);
		Элементы.ПолеПараметрЗапроса.СписокВыбора.Добавить(Значение);
		ВидДанных.Добавить(Значение, "Ресурс");
	ИначеЕсли ВиртуальнаяТаблица = "ОстаткиИОбороты" Тогда
		Начало = "НачальныйОстаток";
		Приход = "Приход";
		Расход = "Расход";
		Конец = "КонечныйОстаток";
										
		Значение = Ресурс.Значение + Начало;
		Элементы.ПолеРесурс.СписокВыбора.Добавить(Значение);
		Элементы.ПолеПараметрЗапроса.СписокВыбора.Добавить(Значение);
		ВидДанных.Добавить(Значение, "Ресурс");
										
		Значение = Ресурс.Значение + Приход;
		Элементы.ПолеРесурс.СписокВыбора.Добавить(Значение);
		Элементы.ПолеПараметрЗапроса.СписокВыбора.Добавить(Значение);
		ВидДанных.Добавить(Значение, "Ресурс");
										
		Значение = Ресурс.Значение + Расход;
		Элементы.ПолеРесурс.СписокВыбора.Добавить(Значение);
		Элементы.ПолеПараметрЗапроса.СписокВыбора.Добавить(Значение);
		ВидДанных.Добавить(Значение, "Ресурс");
										
		Значение = Ресурс.Значение + Конец;
		Элементы.ПолеРесурс.СписокВыбора.Добавить(Значение);
		Элементы.ПолеПараметрЗапроса.СписокВыбора.Добавить(Значение);
		ВидДанных.Добавить(Значение, "Ресурс");
	Иначе	
		Элементы.ПолеРесурс.СписокВыбора.Добавить(Ресурс.Значение);
		Элементы.ПолеПараметрЗапроса.СписокВыбора.Добавить(Ресурс.Значение);
		ВидДанных.Добавить(Ресурс.Значение, "Ресурс");	
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьПолеВидАгрегации(НазваниеПоля, ТипРеквизита)
	
	ЭлементФормы = Элементы.Найти(НазваниеПоля);
	Если ТипРеквизита = "Число" Тогда
		ЭлементФормы.СписокВыбора.Добавить("СУММА");
		ЭлементФормы.СписокВыбора.Добавить("СРЕДНЕЕ");
	КонецЕсли;
		
	ЭлементФормы.СписокВыбора.Добавить("КОЛИЧЕСТВО");
	ЭлементФормы.СписокВыбора.Добавить("МИНИМУМ");
	ЭлементФормы.СписокВыбора.Добавить("МАКСИМУМ");
КонецПроцедуры

&НаСервере
Функция ОбъектМетаданных(ТипМетаданных)
	ОбъектОтчета = РеквизитФормыВЗначение("Объект");
	ОбъектыМетаданных = ОбъектОтчета.ОбъектыМетаданных(ТипМетаданных); 
	Возврат ОбъектыМетаданных;
КонецФункции

&НаСервере
Функция ВиртуальныеТаблицы(ТипМетаданных)
	ВиртуальныеТаблицы = Новый Массив;	
	Если ТипМетаданных = "Регистр накопления" Тогда
		ВиртуальныеТаблицы.Добавить("Остаток");
		ВиртуальныеТаблицы.Добавить("Оборот");
		ВиртуальныеТаблицы.Добавить("ОстаткиИОбороты");
	ИначеЕсли ТипМетаданных = "Регистр сведений" Тогда
		ВиртуальныеТаблицы.Добавить("СрезПоследних");
		ВиртуальныеТаблицы.Добавить("СрезПервых");
	КонецЕсли;
	Возврат ВиртуальныеТаблицы;
		
КонецФункции

&НаСервере
Функция Реквизиты(СтроковыйОбъектМетаданных, Тип, Вид)
	ОбъектОтчета = РеквизитФормыВЗначение("Объект");
	Реквизиты = ОбъектОтчета.РеквизитыОбъектаМетаданных(ТипМетаданных, СтроковыйОбъектМетаданных, Тип, Вид);
	Возврат Реквизиты;                                             

КонецФункции



&НаСервере
Функция ТипРеквизита(Название, Вид)
	ОбъектОтчета = РеквизитФормыВЗначение("Объект");
	ТипРеквизита = ОбъектОтчета.НайтиТипПараметра(Название, ОбъектМетаданных, Вид);
	Возврат ТипРеквизита;
КонецФункции




#КонецОбласти

#Область ФормированиеОтчета

&НаКлиенте
Процедура СформироватьОтчет()
	
	РеквизитыДляОтчета = РеквизитыДляОтчета();
	ПараметрыДляОтчета = ПараметрыДляОтчета();
	ГруппировкиДляОтчета = ГруппировкиДляОтчета();
	ИтогиПоДляОтчета = ИтогиПоДляОтчета();
	ПорядокДляОтчета = УпордочитьПоДляОтчета();
	ДатаРегистра = ДатаРегистраДляОтчета(); 
	
	Результат = ОтчетВМодуле(
		ТипМетаданных, 
		ОбъектМетаданных, 
		РеквизитыДляОтчета, 
		ГруппировкиДляОтчета, 
		ПараметрыДляОтчета, 
		Итоги, 
		ИтогиПоДляОтчета, 
		ПорядокДляОтчета, 
		ВиртуальнаяТаблица, 
		ДатаРегистра
	);
	
	Если Результат.Получить("ТабличныйДокумент") <> Неопределено Тогда
		ТабличныйДокумент = Результат.Получить("ТабличныйДокумент");
	Иначе
		ПоказатьПредупреждение(, Строка(Результат.Получить("Ошибка")), 30);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОтчетВМодуле(
	ТипМетаданных, 
	ОбъектМетаданных, 
	Реквизиты, 
	Группировки, 
	Параметры, 
	Итоги, 
	ИтогиПо, 
	Порядок,
	ВиртуальнаяТаблица,
	ДатаРегистра
)
	ОбъектОтчет = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОтчет.СформироватьОтчет(
		ТипМетаданных, 
		ОбъектМетаданных, 
		Реквизиты, 
		Группировки, 
		Параметры, 
		Итоги, 
		ИтогиПо, 
		Порядок, 
		ВиртуальнаяТаблица, 
		ДатаРегистра
	);
	Возврат Результат; 

КонецФункции


&НаКлиенте
Функция РеквизитыДляОтчета()
	Реквизиты = Новый Массив;
	КоличествоРеквизитов = Элементы.ГруппаВыбрать.ПодчиненныеЭлементы.Количество();
	Если КоличествоРеквизитов <> 0 Тогда
		Пока КоличествоРеквизитов - 1 >= 0  Цикл
			КоличествоРеквизитов = КоличествоРеквизитов - 1;
			Элемент = Элементы.ГруппаВыбрать.ПодчиненныеЭлементы.Получить(КоличествоРеквизитов).Заголовок;
			ЕслиЛиВиртуальнаяТаблица = Элементы.ГруппаВыбрать.ПодчиненныеЭлементы.Получить(КоличествоРеквизитов).Подсказка;
			Если НЕ ЗначениеЗаполнено(ЕслиЛиВиртуальнаяТаблица) Тогда	
				ЕслиЛиВиртуальнаяТаблица = Неопределено;
			КонецЕсли;
			ЕстьЛиАгрегация = Найти(Элемент, "(");                          
			Если ЕстьЛиАгрегация > 0 Тогда
				Позиция = СтрНайти(Элемент, "(");
				Если ЕслиЛиВиртуальнаяТаблица <> Неопределено Тогда
					ВставляемаяСтрока = ОбъектМетаданных+"."+ЕслиЛиВиртуальнаяТаблица+".";
				Иначе
					ВставляемаяСтрока = ОбъектМетаданных+".";
				КонецЕсли;
					
				Строка = Лев(Элемент, Позиция) + ВставляемаяСтрока + Сред(Элемент, Позиция + 1);
			Иначе
				Если ЕслиЛиВиртуальнаяТаблица <> Неопределено Тогда
					Строка = ОбъектМетаданных+"."+ЕслиЛиВиртуальнаяТаблица+"."+Элемент; 	
				Иначе
					Строка = ОбъектМетаданных+"."+Элемент;
				КонецЕсли;
			КонецЕсли;	
			Реквизиты.Добавить(Строка);
		КонецЦикла;
		Возврат Реквизиты;
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Функция ПараметрыДляОтчета()
	ПараметрыДляОтчета = Новый Массив;	
	Если ЗначенияПараметров.Количество() <> 0 Тогда
		
		Для каждого Параметр из ЗначенияПараметров Цикл
			ИмяЗначениеПараметров = Новый Соответствие;
			ПолноеНазваниеПараметра = ОбъектМетаданных + "." + Параметр.Представление;
			ЗначениеПараметра = Параметр.Значение;
			ИмяЗначениеПараметров.Вставить(ПолноеНазваниеПараметра, ЗначениеПараметра);
			ПараметрыДляОтчета.Добавить(ИмяЗначениеПараметров);
		КонецЦикла;
	КонецЕсли;
	Возврат ПараметрыДляОтчета;
КонецФункции 

&НаКлиенте
Функция ГруппировкиДляОтчета()
	
	Группировки = Новый Массив;
	КоличествоГруппировок = Элементы.ГруппаСгруппироватьПо.ПодчиненныеЭлементы.Количество();
	Если КоличествоГруппировок <> 0 Тогда
		Пока КоличествоГруппировок - 1 >= 0  Цикл
			КоличествоГруппировок = КоличествоГруппировок - 1;
			Элемент = Элементы.ГруппаСгруппироватьПо.ПодчиненныеЭлементы.Получить(КоличествоГруппировок).Заголовок;
			ЕстьЛиВиртуальнаяТаблица = Элементы.ГруппаСгруппироватьПо.ПодчиненныеЭлементы.Получить(КоличествоГруппировок).Подсказка;
			Если НЕ ЗначениеЗаполнено(ЕстьЛиВиртуальнаяТаблица) Тогда	
				ЕстьЛиВиртуальнаяТаблица = Неопределено;
			КонецЕсли;
				
			Если ЕстьЛиВиртуальнаяТаблица <> Неопределено Тогда
				Строка = ОбъектМетаданных + "." + ЕстьЛиВиртуальнаяТаблица + "." + Элемент; 	
			Иначе
				Строка = ОбъектМетаданных + "." + Элемент;
			КонецЕсли;

			Группировки.Добавить(Строка);
		КонецЦикла;
	КонецЕсли;
	Возврат Группировки;
	
КонецФункции

&НаКлиенте
Функция ИтогиПоДляОтчета()
	
	ИтогиПоДляОтчета = Новый Массив;
	КоличествоИтогов = Элементы.ГруппаПо.ПодчиненныеЭлементы.Количество();
	Если КоличествоИтогов <> 0 Тогда
		
		Пока КоличествоИтогов - 1 >= 0  Цикл
			КоличествоИтогов = КоличествоИтогов - 1;
			Элемент = Элементы.ГруппаПо.ПодчиненныеЭлементы.Получить(КоличествоИтогов).Заголовок;
			ЕстьЛиВиртуальнаяТаблица = Элементы.ГруппаПо.ПодчиненныеЭлементы.Получить(КоличествоИтогов).Подсказка;
			Если НЕ ЗначениеЗаполнено(ЕстьЛиВиртуальнаяТаблица) Тогда	
				ЕстьЛиВиртуальнаяТаблица = Неопределено;
			КонецЕсли;
				
			Если ЕстьЛиВиртуальнаяТаблица <> Неопределено Тогда
				Строка = ОбъектМетаданных + "." + ЕстьЛиВиртуальнаяТаблица + "." + Элемент; 	
			Иначе
				Строка = ОбъектМетаданных + "." + Элемент;
			КонецЕсли;
			ИтогиПоДляОтчета.Добавить(Строка);
		КонецЦикла;
	
	КонецЕсли;
	Возврат ИтогиПоДляОтчета;
	
КонецФункции

&НаКлиенте
Функция УпордочитьПоДляОтчета() 
	
	УпорядочитьПоДляОтчета = Новый Массив;
	КоличествоПорядков = Элементы.ГруппаУпорядочитьПо.ПодчиненныеЭлементы.Количество();
	Если КоличествоПорядков <> 0 Тогда
		
		Пока КоличествоПорядков - 1 >= 0  Цикл
			КоличествоПорядков = КоличествоПорядков - 1;
			Элемент = Элементы.ГруппаУпорядочитьПо.ПодчиненныеЭлементы.Получить(КоличествоПорядков).Заголовок;
			ЕстьЛиВиртуальнаяТаблица = Элементы.ГруппаУпорядочитьПо.ПодчиненныеЭлементы.Получить(КоличествоПорядков).Подсказка;
			Если НЕ ЗначениеЗаполнено(ЕстьЛиВиртуальнаяТаблица) Тогда	
				ЕстьЛиВиртуальнаяТаблица = Неопределено;
			КонецЕсли;
				
			Если ЕстьЛиВиртуальнаяТаблица <> Неопределено Тогда
				Строка = ОбъектМетаданных + "." + ЕстьЛиВиртуальнаяТаблица + "." + Элемент; 	
			Иначе
				Строка = ОбъектМетаданных + "." + Элемент;
			КонецЕсли;
			УпорядочитьПоДляОтчета.Добавить(Строка);
		КонецЦикла;
	
	КонецЕсли;
	Возврат УпорядочитьПоДляОтчета;
	
КонецФункции

&НаКлиенте
Функция ДатаРегистраДляОтчета()
	ДатаРегистра = Новый Массив;
	Если ЗначениеЗаполнено(РегистрНачало) Тогда
		ДатаРегистра.Добавить(РегистрНачало);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РегистрКонец) Тогда
		ДатаРегистра.Добавить(РегистрКонец);
	КонецЕсли;
	
	Возврат ДатаРегистра;
КонецФункции

#КонецОбласти

 #Область ВспомогательныеФункции
                                        
&НаСервере                                                                                        
Функция СтрокаБезСкобок(Строка)
	ПозицияПервойСкобки = СтрНайти(Строка, "(");
	СтрокаБезПервойСкобки = Сред(Строка, ПозицияПервойСкобки + 1); 
	ПозицияВторойСкобки = СтрНайти(СтрокаБезПервойСкобки, ")");
	СтрокаБезСкобок = Сред(Строка, ПозицияПервойСкобки + 1, ПозицияВторойСкобки - 1); 
	Возврат СтрокаБезСкобок;
	                                                                                                      
КонецФункции                                                                                              

&НаСервере
Функция ЗначениеРеквизитаПоНазванию(ПутьКДанным)
	Реквизиты = ПолучитьРеквизиты();
	Для Каждого Реквизит из Реквизиты Цикл
		Если Реквизит.Имя = ПутьКДанным Тогда
			Возврат ЭтотОбъект[Реквизит.Имя];
		КонецЕсли;
	КонецЦикла;	
КонецФункции

&НаСервере
Функция РесурсБезСуффикса(РесурсОбъектаМетаданных, ВиртуальнаяТаблица)
	
	Если ВиртуальнаяТаблица = "Остаток" Тогда
		Результат = Лев(РесурсОбъектаМетаданных, СтрДлина(РесурсОбъектаМетаданных) - 7);
	ИначеЕсли ВиртуальнаяТаблица = "Оборот" Тогда
		Результат = Лев(РесурсОбъектаМетаданных, СтрДлина(РесурсОбъектаМетаданных) - 6);
	ИначеЕсли  ВиртуальнаяТаблица = "ОстаткиИОбороты" Тогда
		Если Прав(РесурсОбъектаМетаданных, 16) = "НачальныйОстаток" Тогда
			Результат = Лев(РесурсОбъектаМетаданных, СтрДлина(РесурсОбъектаМетаданных) - 16);
		ИначеЕсли Прав(РесурсОбъектаМетаданных, 6) = "Приход" Тогда
			Результат = Лев(РесурсОбъектаМетаданных, СтрДлина(РесурсОбъектаМетаданных) - 6);
		ИначеЕсли Прав(РесурсОбъектаМетаданных, 6) = "Расход" Тогда
			Результат = Лев(РесурсОбъектаМетаданных, СтрДлина(РесурсОбъектаМетаданных) - 6);
		ИначеЕсли Прав(РесурсОбъектаМетаданных, 15) = "КонечныйОстаток" Тогда
			Результат = Лев(РесурсОбъектаМетаданных, СтрДлина(РесурсОбъектаМетаданных) - 15);
		Иначе
			Возврат РесурсОбъектаМетаданных;
		КонецЕсли;
	Иначе
		Возврат РесурсОбъектаМетаданных; 
	КонецЕсли;
	
	Возврат Результат;
КонецФункции


&НаСервере
Функция ТипДанныхРеквизита(Название, ОбъектМетаданных, ВиртуальнаяТаблица = "")
	Если Элементы.ПолеРеквизит.СписокВыбора.НайтиПоЗначению(Название) <> Неопределено Тогда
		Возврат "Реквизит";
	КонецЕсли;
	Возврат "Измерение";
КонецФункции


